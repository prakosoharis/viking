# User App Environment - PRODUCTION SERVER
# API URL untuk production (gunakan domain atau IP server)

# Opsi 1: Jika pakai subdomain API
# VITE_API_URL=http://api.deluwang.online

# Opsi 2: Jika API di path yang sama (recommended)
VITE_API_URL=http://deluwang.online/api

# Opsi 3: Jika pakai IP server langsung
# VITE_API_URL=http://your-server-ip:3202/api
