# Backend Environment Configuration
# Copy file ini sesuai environment:
# - Local: cp .env.local.example .env
# - Production: cp .env.production.example .env

NODE_ENV=development
PORT=3202
MONGODB_URI=mongodb://admin:admin123@localhost:27017/invoice_db?authSource=admin

# Admin API authentication (wajib diisi, backend menolak start kalau kosong)
JWT_SECRET=ganti-dengan-string-acak-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
