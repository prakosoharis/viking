NODE_ENV=development
PORT=3202
MONGODB_URI=mongodb://admin:admin123@localhost:27017/invoice_db?authSource=admin

# Brevo Email Service
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_DOMAIN=clickz.co.no
# Multiple recipients (comma-separated, no spaces after commas)
EMAIL_TO=prakoso.haris@gmail.com,carlolsen70@gmail.com,deutziahope@gmail.com
# Upload limits per session (one email per session) — whichever is hit first rejects the upload.
# Brevo allows 20MB per email and attachments grow ~33% as base64, so keep the total around 14MB.
EMAIL_MAX_FILES=5
EMAIL_MAX_TOTAL_MB=14
